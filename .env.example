# ══════════════════════════════════════════════════
#  BIGSTACK — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to GitHub
# ══════════════════════════════════════════════════

# ─── Telegram Bot ───────────────────────────────────
BOT_TOKEN=
OWNER_ID=

# ─── Database ───────────────────────────────────────
MONGO_URL=

# ─── Environment ────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── API Server (for payment webhooks) ──────────────
API_PORT=3000
API_BASE_URL=

# ─── WebApp / Mini App (Phase 3) ────────────────────
WEBAPP_URL=
JWT_SECRET=
WEBAPP_SECRET=

# ─── AI Providers ───────────────────────────────────
GROQ_API_KEY=
DAVIDCYRIL_KEY=

# ─── Payment Providers ──────────────────────────────
SONICPESA_API_KEY=
SONICPESA_API_SECRET=
SONICPESA_ENV=production

# ─── Optional API Keys ──────────────────────────────
YOUTUBE_API_KEY=
TMDB_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=